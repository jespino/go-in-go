{
  "llvm-target": "x86_64-unknown-linux-gnu",
  "cpu": "x86-64",
  "features": "+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87",
  "build-tags": ["goingo", "baremetal", "linux", "amd64"],
  "goos": "linux",
  "goarch": "amd64",
  "gc": "conservative",
  "scheduler": "tasks",
  "linker": "ld.lld",
  "rtlib": "compiler-rt",
  "relocation-model": "pic",
  "default-stack-size": 65536,
  "automatic-stack-size": false,
  "cflags": [
    "-fPIC",
    "-ffreestanding",
    "-fno-builtin",
    "-fno-stack-protector",
    "-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
    "-ffunction-sections", "-fdata-sections"
  ],
  "ldflags": [
    "-shared",
    "-Bsymbolic",
    "--gc-sections",
    "-znow",
    "-znoexecstack",
    "--hash-style=sysv",
    "--build-id=none"
  ],
  "extra-files": [
    "src/runtime/asm_amd64.S",
    "src/internal/task/task_stack_amd64.S",
    "src/goingo/libc.c"
  ]
}
